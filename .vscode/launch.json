{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MVC App (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\mvc_app.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\Strawberry\\c\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C++ MVCアプリのビルド"
        }
    ]
}
